# Microsite Factory — required secrets (copy to .env AND ~/.hermes/.env; never commit real values)
# Anthropic auth: preferred path is `hermes model` → Anthropic OAuth (Max + extra-usage credits).
# Fallback only:
ANTHROPIC_API_KEY=
# Linkup search — mandatory for account-researcher (no bundled search on the OAuth path)
LINKUP_API_KEY=
# Cloudflare: scoped token, Account → Cloudflare Pages → Edit ONLY. Never a Global API Key.
CLOUDFLARE_API_TOKEN=
# Convex deployment key (scopes agent access to the deployment)
CONVEX_DEPLOY_KEY=
# Shared secret for Convex /fleet and /trace HTTP actions (x-factory-key header)
FACTORY_KEY=
# HMAC secret shared between the frontend signing Function and the Hermes webhooks
WEBHOOK_HMAC_SECRET=

# Convex HTTP actions base URL (https://<deployment>.convex.site)
CONVEX_SITE_URL=
