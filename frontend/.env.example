# ---------------------------------------------------------------------------
# CLIENT build environment (Vite). Copy to `.env.local`.
#
# Only VITE_* vars are exposed to the browser bundle. NEVER put a secret here.
# The HMAC secret belongs in the Functions env (.dev.vars) — see .dev.vars.example.
# ---------------------------------------------------------------------------

# Convex deployment URL the fleet board reads live from.
# From `npx convex dev` output, e.g. https://your-deployment.convex.cloud
VITE_CONVEX_URL="https://your-deployment.convex.cloud"

# Optional: "true" runs the board on a simulated live fleet (no Convex needed).
# For local design review / offline rehearsal only — never enable in production.
# VITE_DEMO_MODE="false"
